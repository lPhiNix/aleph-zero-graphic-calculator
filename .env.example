# ---------------------------------------------------------------------------
# Aleph-Zero configuration
#
# Copy this file to `.env` and adjust the values. These are the only settings
# the application exposes; all variables are prefixed with ALEPHZERO_.
# ---------------------------------------------------------------------------

# --- Database (MySQL) ---
# Full JDBC URL. In Docker Compose the host is the service name (db).
ALEPHZERO_DB_URL=jdbc:mysql://localhost:3306/mysqldb
ALEPHZERO_DB_USERNAME=root
ALEPHZERO_DB_PASSWORD=1234

# --- Authentication (stateless JWT) ---
# Signing secret for access tokens. MUST be at least 32 bytes long.
ALEPHZERO_JWT_SECRET=change-me-this-secret-must-be-at-least-32-bytes-long!!
# Access token lifetime (Spring Duration format: 15m, 1h, ...).
ALEPHZERO_JWT_ACCESS_TTL=15m
# Refresh token lifetime (7d, 30d, ...).
ALEPHZERO_JWT_REFRESH_TTL=7d
# Name of the HttpOnly cookie that carries the refresh token.
ALEPHZERO_JWT_COOKIE_NAME=refresh_token
# Mark the refresh cookie Secure. Set to true when serving over HTTPS (production).
ALEPHZERO_JWT_COOKIE_SECURE=false

# --- Frontend origin (CORS) ---
# Only relevant when frontend and backend are served from different origins (dev).
# In production (single binary, same origin) it can be left pointing at the public URL.
ALEPHZERO_FRONTEND_URL=http://localhost:5173

# --- OpenAPI / Swagger UI ---
# Disabled by default for production; set to true for development.
ALEPHZERO_SWAGGER_ENABLED=false
